    "steps": [
        {
            "number": 1,
            "description": "将肉切成丝备用。"
        },
        {
            "number": 2,
            "description": "将胡萝卜、青椒、土豆、木耳洗净备用。"
        },
        {
            "number": 3,
            "description": "素肉丝用温水二三分钟捞出备用。"
        },
        {
            "number": 4,
            "description": "将木耳用温水泡发，切丝，胡萝卜、青椒、土豆切丝，葱、蒜、姜切末。"
        },
        {
            "number": 5,
            "description": "将湿淀粉、盐、白糖、醋、酱油、兑成汁。"
        },
        {
            "number": 6,
            "description": "锅内放油，烧至五成热下豆瓣酱炒香，再将蒜、葱、姜末炒香。"
        },
        {
            "number": 7,
            "description": "倒入木耳、土豆丝倒入翻炒。"
        },
        {
            "number": 8,
            "description": "再将青椒丝、胡萝卜丝倒入翻炒。"
        },
        {
            "number": 9,
            "description": "倒入调好汁翻炒均匀后。"
        },
        {
            "number": 10,
            "description": "最后放入素肉丝翻炒均匀即可。"
        }
    ],
