    "steps": [
        {
            "number": 1,
            "description": "主料:猪里脊1条清洗干净，放入冰箱稍冻一会，这样肉片会切的更薄。"
        },
        {
            "number": 2,
            "description": "配料:油菜、金针菇、绿豆牙。"
        },
        {
            "number": 3,
            "description": "将金针菇切掉根部清洗干净、绿豆芽掐去根部清洗干净，油菜清洗干净。"
        },
        {
            "number": 4,
            "description": "将猪里脊切薄片。"
        },
        {
            "number": 5,
            "description": "加入少量生抽、适量料酒、白糖、淀粉、胡椒粉、清水将里脊腌制20分钟。"
        },
        {
            "number": 6,
            "description": "炒锅烧热加入植物油，将肉片煸炒。"
        },
        {
            "number": 7,
            "description": "至变颜色约七分熟时盛出备用。"
        },
        {
            "number": 8,
            "description": "另起锅放入姜、蒜、陴县豆瓣酱炒香。"
        },
        {
            "number": 9,
            "description": "加入适量清水烧开，把青菜放入烫熟。"
        },
        {
            "number": 10,
            "description": "青菜盛在较大的容器里。"
        },
        {
            "number": 11,
            "description": "将肉片放入锅中大火烧开即可。"
        },
        {
            "number": 12,
            "description": "将肉片盛在青菜上，倒入汤。"
        },
        {
            "number": 13,
            "description": "在上面放入麻椒、干红辣椒，锅内烧热油浇在上面即可。"
        }
    ],
