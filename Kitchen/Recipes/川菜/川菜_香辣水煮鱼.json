    "steps": [
        {
            "number": 1,
            "description": "将鱼洗净去头去骨切成两片。（我的鱼买错成鲢鱼呢，最好用草鱼）"
        },
        {
            "number": 2,
            "description": "将两半鱼肉用刀斜切成片。"
        },
        {
            "number": 3,
            "description": "这就是所有需要的材料了。"
        },
        {
            "number": 4,
            "description": "将鱼片加入一勺淀粉，一勺料酒和半勺胡椒粉抓均腌制15分钟。"
        },
        {
            "number": 5,
            "description": "上锅入水烧开，加入一勺油，将豆芽烫熟捞出盛在较大的盆里。"
        },
        {
            "number": 6,
            "description": "倒掉烫豆芽的水重新上锅，爆香切碎的大蒜和姜片。"
        },
        {
            "number": 7,
            "description": "加入两勺豆瓣酱炒出红油。"
        },
        {
            "number": 8,
            "description": "再加入大约500毫升的水。（此刻可根据自己的口味看是否要下盐，我是下了半勺的盐刚好）"
        },
        {
            "number": 9,
            "description": "盖上锅盖煮开。"
        },
        {
            "number": 10,
            "description": "将鱼片一片一片的放入煮开的汤料里。上盖子将鱼片煮开马上捞出鱼片。（煮鱼片时不要用锅铲去翻煸，否则弄碎鱼片）"
        },
        {
            "number": 11,
            "description": "将煮熟的鱼片放入烫熟的豆芽表面，铺上一半的干辣椒和花椒。"
        },
        {
            "number": 12,
            "description": "再重新上锅，加入50毫升的油烧热，将另一半的辣椒和花椒炸至变色出味。"
        },
        {
            "number": 13,
            "description": "再将炸过的辣椒花椒油一同倒入鱼片上面完成。"
        },
        {
            "number": 14,
            "description": "成品。放入几片香菜叶做点缀。"
        },
        {
            "number": 15,
            "description": "成品。"
        }
    ],
    "_source": "cookbook-kg"
}