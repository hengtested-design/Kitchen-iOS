    "steps": [
        {
            "number": 1,
            "description": "准备材料：牛肉一块，豆芽一小袋，香菜适量。"
        },
        {
            "number": 2,
            "description": "牛肉切片洗去血水，捏干，加少许盐，鸡精，地瓜粉，清水抓匀腌制。"
        },
        {
            "number": 3,
            "description": "香菜洗净切小段。"
        },
        {
            "number": 4,
            "description": "豆芽洗净沥干水分。"
        },
        {
            "number": 5,
            "description": "适量色拉油，加两勺郫县豆瓣酱，蒜片还有姜片煸炒出红油。"
        },
        {
            "number": 6,
            "description": "加两饭碗的清水煮开。"
        },
        {
            "number": 7,
            "description": "把汤汁过滤出来待用，其余的渣倒掉。"
        },
        {
            "number": 8,
            "description": "锅洗干净，把过滤好的汤汁重新倒回锅中煮开。"
        },
        {
            "number": 9,
            "description": "下入豆芽，半勺的盐，半勺的鸡精，煮至豆芽开始变透明即可，不要煮太久，吃起来才会有爽脆的口感。"
        },
        {
            "number": 10,
            "description": "把豆芽捞出来放入碗底。"
        },
        {
            "number": 11,
            "description": "再下入腌制好的牛肉片滑散至刚熟，下入少许的料酒去腥。"
        },
        {
            "number": 12,
            "description": "然后连汤带牛肉都一起倒入碗里。"
        },
        {
            "number": 13,
            "description": "撒上香菜末。"
        },
        {
            "number": 14,
            "description": "适量色拉油煸香花椒和辣椒干。"
        },
        {
            "number": 15,
            "description": "最后浇在香菜上即可。"
        }
    ],
    "_source": "cookbook-kg"
