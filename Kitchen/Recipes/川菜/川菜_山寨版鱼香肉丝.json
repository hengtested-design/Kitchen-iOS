    "steps": [
        {
            "number": 1,
            "description": "将葱姜蒜、尖辣椒切碎备用。"
        },
        {
            "number": 2,
            "description": "猪肉化冻后，切细丝。"
        },
        {
            "number": 3,
            "description": "土豆切细丝，入凉水中浸泡备用。"
        },
        {
            "number": 4,
            "description": "青椒去籽，切细丝。"
        },
        {
            "number": 5,
            "description": "水发木耳切细丝。"
        },
        {
            "number": 6,
            "description": "锅中倒少许油，油热下入葱姜蒜、尖椒爆香。"
        },
        {
            "number": 7,
            "description": "倒入肉丝煸炒，加入料酒、生抽、老抽翻炒。"
        },
        {
            "number": 8,
            "description": "倒入土豆丝，倒糖、醋和盐翻炒片刻。"
        },
        {
            "number": 9,
            "description": "加入木耳继续翻炒。"
        },
        {
            "number": 10,
            "description": "最好加入青椒丝翻炒。"
        },
        {
            "number": 11,
            "description": "临出锅前撒鸡精调味，即可。"
        },
