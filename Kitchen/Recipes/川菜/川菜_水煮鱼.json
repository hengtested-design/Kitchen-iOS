    "calories": 240,
    "difficulty": 2,
    "duration": 60,
    "servings": 2,
    "tags": [
        "麻辣",
        "煮"
    ],
    "ingredients": [
        {
            "name": "草鱼",
            "amount": 1,
            "unit": "条",
            "isMain": true
        },
        {
            "name": "黄豆芽",
            "amount": 0,
            "unit": "适量",
            "isMain": true
        },
        {
            "name": "干辣椒",
            "amount": 0,
            "unit": "适量",
            "isMain": false
        },
        {
            "name": "花椒",
            "amount": 0,
            "unit": "适量",
            "isMain": false
        },
        {
            "name": "姜",
            "amount": 1,
            "unit": "块",
            "isMain": false
        }
    ],
    "steps": [
        {
            "number": 1,
            "description": "准备食材。"
        },
        {
            "number": 2,
            "description": "将鱼清洗干净后切片，鱼骨和鱼肉分开放。黄豆芽去掉须根、辣椒剪成段、姜切片。接下来开始腌鱼。鱼骨中放入三四片姜、一勺料酒、半勺盐腌制二十分钟。鱼片中放入半只蛋清、一勺料酒、一勺淀粉、一小勺白胡椒粉后抓匀腌制二十分钟。"
        },
        {
            "number": 3,
            "description": "锅中加适量清水，水烧开后将黄豆芽放入锅中，再放少许盐。待黄豆芽煮熟捞出放入大碗内。"
        },
        {
            "number": 4,
            "description": "锅中倒入少许油，油热后放入一勺郫县豆瓣酱和姜片煸炒出红油（喜欢更辣一点口感的，可以往锅里再放一些干辣椒煸炒出香味）。"
        },
        {
            "number": 5,
            "description": "往锅里倒入适量的热水。"
        },
        {
            "number": 6,
            "description": "将鱼骨放入锅内，大火烧开后转小火炖10分钟。（这个时候可以尝一下鱼汤的味道，然后根据自己的口味选择要不要放盐）鱼骨炖好后捞到装有黄豆芽的大碗中。"
        },
        {
            "number": 7,
            "description": "将鱼肉一片一片的放入锅中。（千万不要搅动，如需要，只要轻轻晃动几下锅即可）"
        },
        {
            "number": 8,
            "description": "煮开后立即将鱼肉捞出，再盛一些汤到碗中。"
        },
        {
            "number": 9,
            "description": "换一只干净的锅中，锅中倒入40毫升左右的食用油，然后将干辣椒和花椒放入锅中，小火煸炒至辣椒红亮，花椒出香味即可捞出放到鱼肉上。"
        },
        {
            "number": 10,
            "description": "将锅中剩下的油大火烧至稍稍冒烟，然后关火，把油淋在鱼肉上即可。"
        }
    ],
    "_source": "cookbook-kg"
}