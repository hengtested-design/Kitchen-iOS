    "steps": [
        {
            "number": 1,
            "description": "3斤左右草鱼一条，去头、内脏、鱼骨、鱼皮，只留净鱼肉；"
        },
        {
            "number": 2,
            "description": "斜刀片成薄片；"
        },
        {
            "number": 3,
            "description": "加料酒、蛋清、生粉、盐，拌匀；"
        },
        {
            "number": 4,
            "description": "白皮黄瓜去皮籽，对剖后切成厚片，榨菜洗净切成大片；"
        },
        {
            "number": 5,
            "description": "大蒜、生姜切大片，干尖椒剪成段，花椒洗净备用；"
        },
        {
            "number": 6,
            "description": "准备德庄水煮鱼调料一包；"
        },
        {
            "number": 7,
            "description": "锅中倒入100克油，大火烧至七成热时，依次下入生姜、大蒜、干尖椒、花椒，爆香，小火炼出辣油；"
        },
        {
            "number": 8,
            "description": "转大火，下入黄瓜和榨菜片爆炒；"
        },
        {
            "number": 9,
            "description": "将水煮鱼调料倒入锅中；"
        },
        {
            "number": 10,
            "description": "加入大半锅水，大火煮沸后转小火，再煮15-20分钟；"
        },
        {
            "number": 11,
            "description": "将煮好的黄瓜捞起置于一大碗中；"
        },
        {
            "number": 12,
            "description": "转大火，将锅中汤汁煮至沸腾，下入腌好的鱼片；"
        },
        {
            "number": 13,
            "description": "氽至鱼片断生马上关火，将鱼片和汤汁尽数倒入碗中；"
        },
        {
            "number": 14,
            "description": "撒上香葱末；"
        },
        {
            "number": 15,
            "description": "将剩余的100克油置于汤勺中，加热至冒青烟；"
        },
        {
            "number": 16,
            "description": "将热油浇于鱼表面即可。"
        }
    ],
    "_source": "cookbook-kg"
}