    "steps": [
        {
            "number": 1,
            "description": "鸡翅洗净，葱姜切大片，柠檬切两半。"
        },
        {
            "number": 2,
            "description": "先给洗净的鸡翅用牙签来做个针灸，孔越多越好，方便入味。"
        },
        {
            "number": 3,
            "description": "扎了孔的鸡翅用酱油，葱姜片，盐，料酒，和适量柠檬汁腌30分钟以上。"
        },
        {
            "number": 4,
            "description": "然后把腌过的鸡翅入5成油锅炸三四分钟，外皮金黄即可捞出。"
        },
        {
            "number": 5,
            "description": "炸好的鸡翅和之前腌鸡翅的料再加半瓶可乐一起放入炒锅中大火烧开。"
        },
        {
            "number": 6,
            "description": "转小火炖。"
        },
        {
            "number": 7,
            "description": "小火炖至汁快收干时改大火收汁，再挤几滴柠檬汁再鸡翅上即可食用。"
        },
        {
            "number": 8,
            "description": "出锅装盘。"
        }
    ],
