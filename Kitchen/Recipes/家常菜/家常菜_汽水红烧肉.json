    "steps": [
        {
            "number": 1,
            "description": "主料准备好"
        },
        {
            "number": 2,
            "description": "将五花肉洗净，切麻将块大小"
        },
        {
            "number": 3,
            "description": "姜蒜切片，干辣椒冲洗干净"
        },
        {
            "number": 4,
            "description": "锅里不放油，将切好的五花肉放入煸炒"
        },
        {
            "number": 5,
            "description": "煸炒出一些油分后，放入姜片继续煸炒"
        },
        {
            "number": 6,
            "description": "炒至五花肉有些焦黄色，油分也差不多全出来后放入蒜头、干辣椒拌炒出香味"
        },
        {
            "number": 7,
            "description": "随后淋入生抽、老抽、料酒，炒至上色"
        },
        {
            "number": 8,
            "description": "倒入汽水，漫过肉为宜，一罐刚好"
        },
        {
            "number": 9,
            "description": "大火烧开，小火焖煮40分钟左右，焖久一点也行"
        },
        {
            "number": 10,
            "description": "最后大火收汁即可"
        }
    ],
