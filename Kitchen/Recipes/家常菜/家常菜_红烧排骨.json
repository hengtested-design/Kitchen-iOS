    "steps": [
        {
            "number": 1,
            "description": "食材洗净、备好。"
        },
        {
            "number": 2,
            "description": "锅内放入花椒、姜片、葱段，注入半锅水烧至温热，即锅底冒小泡，但未沸腾。"
        },
        {
            "number": 3,
            "description": "放入排骨焯烫至水沸，捞出控干水分。"
        },
        {
            "number": 4,
            "description": "炒锅内放入少许油，放冰糖，小火炒至熔化。"
        },
        {
            "number": 5,
            "description": "糖色变浅黄褐色并冒细泡时，迅速放入排骨，炒至均匀上糖色。"
        },
        {
            "number": 6,
            "description": "继续加入酱油、料酒炒匀，加入热水没过排骨1寸，大火烧开，转小火炖40分钟左右。"
        },
        {
            "number": 7,
            "description": "加盐，继续炖至排骨熟烂入味，大火收干汤汁即可。"
        },
        {
            "number": 8,
            "description": "出锅，摆盘。"
        }
    ],
    "_source": "cookbook-kg"
