    "steps": [
        {
            "number": 1,
            "description": "冷锅上油，放入冰糖慢慢的融化开。"
        },
        {
            "number": 2,
            "description": "冰糖全部融化完，倒入排骨中火翻炒。"
        },
        {
            "number": 3,
            "description": "炒一会儿，倒入葱姜蒜。"
        },
        {
            "number": 4,
            "description": "继续翻炒一会儿，可闻见香味了。"
        },
        {
            "number": 5,
            "description": "撒上调料，倒入酱油。"
        },
        {
            "number": 6,
            "description": "继续翻炒一会儿，放大八角、大料、盐，倒入水漫过肉,。"
        },
        {
            "number": 7,
            "description": "炖上30分钟时放盐再炖20分钟左右。"
        },
        {
            "number": 8,
            "description": "肉炖烂，倒入土豆再炖一会儿，到土豆炖烂为止。"
        },
        {
            "number": 9,
            "description": "放鸡精，可以出锅了。"
        }
    ],
