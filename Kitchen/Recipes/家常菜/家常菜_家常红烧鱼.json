    "steps": [
        {
            "number": 1,
            "description": "海鱼刨肚去肠清洗干净，葱切段，姜、蒜切片，五花肉切条；"
        },
        {
            "number": 2,
            "description": "炒锅放入一汤匙植物油，放入葱姜蒜煸出香味"
        },
        {
            "number": 3,
            "description": "放入五花肉翻炒；"
        },
        {
            "number": 4,
            "description": "待五花肉煸至出油变成金黄色，放入一大勺酱油；"
        },
        {
            "number": 5,
            "description": "五花肉在酱油里稍炖一会，炖出香味；"
        },
        {
            "number": 6,
            "description": "锅中放入适量的水，水量要一次放足，放入一汤匙的料酒；"
        },
        {
            "number": 7,
            "description": "放入鱼，大火烧开，转中小火炖15分钟；"
        },
        {
            "number": 8,
            "description": "放适量的盐调味，大火收一下汤汁，即可起锅；"
        },
        {
            "number": 9,
            "description": "装盘后放适量的香菜和红椒丝装饰。"
        }
    ],
    "_source": "cookbook-kg"
