    "steps": [
        {
            "number": 1,
            "description": "刺鱼洗净，背上划上几刀，两边抹上盐，鸡精少许，用黄酒腌制10分钟。"
        },
        {
            "number": 2,
            "description": "锅热倒入油，（我用的是妈妈家做的土菜油，土菜油做鱼炒鸡肉鸭肉都特别的香）菜油一定要烧热，把刺鱼放入锅里两边煎黄，可以关中火，千万别着急哦。"
        },
        {
            "number": 3,
            "description": "鱼两边煎好，把切好的姜丝 大蒜仍油里煎出味道: 3"
        },
        {
            "number": 4,
            "description": "倒入适量的黄酒盖子盖上焖一分钟，开盖倒入生抽，加冷水（没过刺鱼）放适量的盐，白糖 ，白醋少许，盐少许。: 4"
        },
        {
            "number": 5,
            "description": "大火烧开，锅盖盖好，中火略炖，炖8分钟的样子放入青红椒。: 5"
        }
    ],
