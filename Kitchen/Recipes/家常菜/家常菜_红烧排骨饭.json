    "steps": [
        {
            "number": 1,
            "description": "锅内烧开水，放入斩好的排骨氽烫至出血水，捞起洗净，沥净水备用。"
        },
        {
            "number": 2,
            "description": "将葱，姜，蒜，八角准备好。"
        },
        {
            "number": 3,
            "description": "锅中放适量油，将葱，姜，蒜先炒香。"
        },
        {
            "number": 4,
            "description": "加入排骨，倒入生抽，老抽，加白糖八角炒到上色。"
        },
        {
            "number": 5,
            "description": "倒入没过的排骨的清水，大火烧开后加盖转小火慢炖。"
        },
        {
            "number": 6,
            "description": "炖至汤汁浓稠，排骨软烂时即可，出锅前加盐调味。"
        },
        {
            "number": 7,
            "description": "开水中加盐加少许色拉油，将西兰花烫熟捞出后加少许盐及橄榄油拌匀。"
        },
        {
            "number": 8,
            "description": "盘中盛米饭，将煮熟的玉米剥下，摆上排骨，西兰花即可。"
        }
    ],
    "_source": "cookbook-kg"
