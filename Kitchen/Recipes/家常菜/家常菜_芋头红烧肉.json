    "steps": [
        {
            "number": 1,
            "description": "１、材料图。"
        },
        {
            "number": 2,
            "description": "２、五花肉切方块焯水，加上葱段。"
        },
        {
            "number": 3,
            "description": "３、姜切片，芋头去皮切滚刀块，倒出适量红烧汁，按300克肉60克汁的比例就可以了，如果加有其它食材，可以适当加量。"
        },
        {
            "number": 4,
            "description": "４、五花肉焯水后捞出淋水"
        },
        {
            "number": 5,
            "description": "５、烧锅倒油，入姜片炒香。"
        },
        {
            "number": 6,
            "description": "６、下五花肉块翻炒。"
        },
        {
            "number": 7,
            "description": "７、肉块变色后倒放红烧汁。"
        },
        {
            "number": 8,
            "description": "８、加适量开水或者高汤。"
        },
        {
            "number": 9,
            "description": "９、将肉同汤汁换至高压锅中，加放芋头块。大火烧开后转小火炖十五分钟。"
        },
        {
            "number": 10,
            "description": "１０、准备装饰葱丝，将葱叶用牙签划开后放在水里。"
        },
        {
            "number": 11,
            "description": "１１、高压锅落阀后，可以加盐调整味道。"
        },
        {
            "number": 12,
            "description": "１２、开火将汤汁收浓，装盘即可。"
        }
    ],
    "_source": "cookbook-kg"
}