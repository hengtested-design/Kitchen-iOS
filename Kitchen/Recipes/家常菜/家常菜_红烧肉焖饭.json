    "steps": [
        {
            "number": 1,
            "description": "五花肉切小块，加入适量料酒和淀粉抓匀备用，洋葱、土豆切丁；"
        },
        {
            "number": 2,
            "description": "锅中放入适量油，将肉块倒下去炒至变色，盛出备用；"
        },
        {
            "number": 3,
            "description": "倒入洋葱丁煸炒；"
        },
        {
            "number": 4,
            "description": "煸炒15分钟左右，直至明显变色、缩小；"
        },
        {
            "number": 5,
            "description": "加入土豆丁和炒好的肉块；"
        },
        {
            "number": 6,
            "description": "略微翻炒后加入酱油；"
        },
        {
            "number": 7,
            "description": "翻炒均匀，加入适量盐；"
        },
        {
            "number": 8,
            "description": "加入淘好的大米；"
        },
        {
            "number": 9,
            "description": "翻匀；"
        },
        {
            "number": 10,
            "description": "将其倒入电饭煲中铺平；"
        },
        {
            "number": 11,
            "description": "加入清水，稍稍高出食材；"
        },
        {
            "number": 12,
            "description": "启动煮饭程序，完成。"
        }
    ],
