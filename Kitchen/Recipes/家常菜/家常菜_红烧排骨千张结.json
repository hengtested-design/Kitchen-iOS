    "steps": [
        {
            "number": 1,
            "description": "排骨影片能够流动水冲洗干净。"
        },
        {
            "number": 2,
            "description": "排骨下入开水锅里加入料酒焯水。"
        },
        {
            "number": 3,
            "description": "焯好的排骨冲净血沫，沥干水份。"
        },
        {
            "number": 4,
            "description": "千张洗净切成约10厘米长3厘米宽的条状。"
        },
        {
            "number": 5,
            "description": "把千张条依次打结。"
        },
        {
            "number": 6,
            "description": "葱切段，姜切片，干辣椒切成小段，八角洗净。"
        },
        {
            "number": 7,
            "description": "锅里倒油烧至5成热放入葱姜、辣椒、八角炒香。"
        },
        {
            "number": 8,
            "description": "放入排骨煸炒。"
        },
        {
            "number": 9,
            "description": "排骨翻炒至表面微黄放入白糖翻炒。"
        },
        {
            "number": 10,
            "description": "放入醋炒匀。"
        },
        {
            "number": 11,
            "description": "放入生抽和老抽翻炒到排骨上色。"
        },
        {
            "number": 12,
            "description": "倒入没过排骨的开水，大火烧开后改中火炖30分钟。"
        },
        {
            "number": 13,
            "description": "改大火放入千张结。"
        },
        {
            "number": 14,
            "description": "炖至汤汁浓稠时放入盐。"
        },
        {
            "number": 15,
            "description": "汤汁快收干的时候放入鲜鸡汁，出锅装盘。"
        }
    ],
    "_source": "cookbook-kg"
