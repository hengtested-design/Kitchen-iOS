    "steps": [
        {
            "number": 1,
            "description": "扒皮鱼去皮，内脏洗净。"
        },
        {
            "number": 2,
            "description": "在鱼身的两边各斜切一刀。"
        },
        {
            "number": 3,
            "description": "放入盘中加五香粉，料酒拌匀腌制20分钟。"
        },
        {
            "number": 4,
            "description": "热锅下油，下放入腌好的鱼两面煎一下。"
        },
        {
            "number": 5,
            "description": "再放入酱油，糖，葱姜，醋，水翻炒均匀。"
        },
        {
            "number": 6,
            "description": "盖盖中火炖10分钟，再用大火收下汁，加美极鲜调味出锅即可。"
        }
