            "number": 1,
            "description": "备排骨。"
        },
        {
            "number": 2,
            "description": "备紫薯。"
        },
        {
            "number": 3,
            "description": "紫薯去皮切成菱形块。"
        },
        {
            "number": 4,
            "description": "排骨入水焯过。"
        },
        {
            "number": 5,
            "description": "坐锅倒油，凉油放糖炒糖色，炒至起沫成红棕色，倒入排骨。"
        },
        {
            "number": 6,
            "description": "排骨上糖色，放入料酒、葱姜、八角、桂皮，炒匀。"
        },
        {
            "number": 7,
            "description": "倒入热水，与排骨持平。烧开后撇出浮沫，放入生抽、盐，炖制。"
        },
        {
            "number": 8,
            "description": "另起一锅，入油，用中小火将紫薯炸熟。"
        },
        {
            "number": 9,
            "description": "排骨将熟时，放入紫薯，大火收汁。"
        }
