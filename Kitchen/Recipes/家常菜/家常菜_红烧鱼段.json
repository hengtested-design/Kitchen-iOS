    "steps": [
        {
            "number": 1,
            "description": "草鱼清理干净"
        },
        {
            "number": 2,
            "description": "对半切成两段；两面上划三刀，用盐抹一层腌5分钟；"
        },
        {
            "number": 3,
            "description": "锅中热油，爆香姜片"
        },
        {
            "number": 4,
            "description": "放入鱼段，不着急翻动它，煎至结痂"
        },
        {
            "number": 5,
            "description": "再翻到另一面，同样煎至结痂"
        },
        {
            "number": 6,
            "description": "倒入适量水，调入生抽、老抽、料酒、米醋、胡椒粉、白糖"
        },
        {
            "number": 7,
            "description": "大火烧，过程中将汤汁浇到鱼的表面。汤汁浓稠，放入香菜段，关火装盘"
        }
