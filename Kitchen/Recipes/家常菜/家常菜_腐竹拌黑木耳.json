    "steps": [
        {
            "number": 1,
            "description": "腐竹用温水浸泡"
        },
        {
            "number": 2,
            "description": "黑木耳浸泡后洗净撕成小块"
        },
        {
            "number": 3,
            "description": "把泡好的腐竹切成小块"
        },
        {
            "number": 4,
            "description": "青椒切成小块"
        },
        {
            "number": 5,
            "description": "把腐竹、黑木耳、青椒放入锅里绰水"
        },
        {
            "number": 6,
            "description": "煮开后捞出沥干水分冷却"
        },
        {
            "number": 7,
            "description": "取一小碗调个浇汁：加入生抽、香醋"
        },
        {
            "number": 8,
            "description": "加点盐、砂糖搅拌均匀后即是浇汁"
        },
        {
            "number": 9,
            "description": "加点蒜末和红辣椒粒"
        },
        {
            "number": 10,
            "description": "把调好的浇汁淋在上面，再淋点自制的红油，最好加热点色拉油和香油爆香蒜末。吃的时候搅拌均匀即可"
        }
