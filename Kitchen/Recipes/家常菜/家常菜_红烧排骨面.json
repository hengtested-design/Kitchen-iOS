    "steps": [
        {
            "number": 1,
            "description": "先说说红烧排骨的做法~排骨斩块之后用水冲一会，冲去血水。"
        },
        {
            "number": 2,
            "description": "准备两节大葱，一小节生姜，几颗冰糖，大料依个人口味，我准备了香叶，桂皮，茴香，花椒等等，超市都有卖的，买组合或者零散着称都行，一勺豆瓣酱，另备一份葱姜蒜切末。"
        },
        {
            "number": 3,
            "description": "冷水加排骨，放入拍开的葱和生姜，盖盖大火煮。"
        },
        {
            "number": 4,
            "description": "水开后漂去浮沫，火可以适当调小一些，尽量把浮沫撇干净，然后捞出排骨，将过滤后的汤盛起来。（如下图）"
        },
        {
            "number": 5,
            "description": "煮好的排骨以及准备好的调料"
        },
        {
            "number": 6,
            "description": "大火热锅，放油，至8成热时放葱姜蒜，炒出香味。"
        },
        {
            "number": 7,
            "description": "放大料和冰糖，稍微翻炒。"
        },
        {
            "number": 8,
            "description": "加一勺豆瓣。"
        },
        {
            "number": 9,
            "description": "加排骨，稍稍炒一下。"
        },
        {
            "number": 10,
            "description": "加刚才过滤的汤。"
        },
        {
            "number": 11,
            "description": "开锅后加少许老抽，上色。"
        },
        {
            "number": 12,
            "description": "如果汤汁多，可以盛一部分出来，当面条的汤底，味道超棒的哦！剩一点继续搅拌收汁。"
        },
        {
            "number": 13,
            "description": "起锅，开动！"
        },
        {
            "number": 14,
            "description": "嘿嘿 吃一口"
        },
        {
            "number": 15,
            "description": "准备煮面条~"
        },
        {
            "number": 16,
            "description": "我比较重口味，喜欢用红烧后的汤来煮面（其实也是比较懒啦，烧完排骨的锅加水就可以煮咯，面里还会带股肉味，很不错都哦~）。"
        },
        {
            "number": 17,
            "description": "水开后下面条，用筷子拨一拨，防止黏在一起。"
        },
        {
            "number": 18,
            "description": "面条煮熟后起锅前加入生菜烫一下。起锅！"
        },
        {
            "number": 19,
            "description": "稍稍放点鸡精加点之前红烧排骨时盛起的汤，再撒上葱花和香菜，就完美啦！更重口味的可以加点盐哦~"
        },
        {
            "number": 20,
            "description": "成品图。"
        }
    ],
