    "steps": [
        {
            "number": 1,
            "description": "五花肉洗净，切成2.5厘米见方的块，用清水加料酒浸泡15分钟。"
        },
        {
            "number": 2,
            "description": "备老抽、葱段、姜片、冰糖。"
        },
        {
            "number": 3,
            "description": "净锅坐火（不放油），倒入沥干水分的五花肉。"
        },
        {
            "number": 4,
            "description": "用锅铲不断煸炒5分钟。"
        },
        {
            "number": 5,
            "description": "炒至肥肉内层自然析出油份，肉面干燥泛黄，肉质微微收缩。"
        },
        {
            "number": 6,
            "description": "烹入老抽。"
        },
        {
            "number": 7,
            "description": "炒制上色。"
        },
        {
            "number": 8,
            "description": "倒入料酒。"
        },
        {
            "number": 9,
            "description": "放入葱段姜片。"
        },
        {
            "number": 10,
            "description": "倒入热水2000克左右。"
        },
        {
            "number": 11,
            "description": "倒入香醋。"
        },
        {
            "number": 12,
            "description": "旺火煮至水沸，此时水面浮现一层黑红色浮沫，用勺撇去浮沫。"
        },
        {
            "number": 13,
            "description": "加盖中小火炖制约40分钟，用筷子能轻松戳透肉皮，倒入冰糖，轻轻翻动肉块。"
        },
        {
            "number": 14,
            "description": "焖至冰糖融化，继续烧制5分钟，至汤汁收到半干，变得浓稠光亮即成。"
        },
        {
            "number": 15,
            "description": "装盘即可。"
        }
    ],
    "_source": "cookbook-kg"
}