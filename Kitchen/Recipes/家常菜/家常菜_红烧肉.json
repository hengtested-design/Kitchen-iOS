    "steps": [
        {
            "number": 1,
            "description": "原料图如图所示。"
        },
        {
            "number": 2,
            "description": "五花肉切麻将大小的块，冲洗干净后，放一汤匙料酒，浸泡一小时。捞出来沥干。"
        },
        {
            "number": 3,
            "description": "锅里放油煸炒肉块到微黄。"
        },
        {
            "number": 4,
            "description": "放入干辣椒，草果，八角，姜，炒出香味。"
        },
        {
            "number": 5,
            "description": "放料酒两汤匙，炒几下，再放老抽，生抽，炒匀。"
        },
        {
            "number": 6,
            "description": "放入开水，淹没肉，转入砂锅煨两个小时调入盐。"
        },
        {
            "number": 7,
            "description": "煨到酥烂的五花肉，放冰糖大火收汁，晃动锅，不要翻动。"
        },
        {
            "number": 8,
            "description": "到汤汁均匀的裹在肉上就好了！放点味精提味。"
        }
    ],
    "_source": "cookbook-kg"
