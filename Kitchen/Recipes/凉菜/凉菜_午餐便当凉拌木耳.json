    "steps": [
        {
            "number": 1,
            "description": "木耳提前泡发，胡萝卜去皮，西红柿洗净；"
        },
        {
            "number": 2,
            "description": "木耳清洗，大朵的，需要用刀切；"
        },
        {
            "number": 3,
            "description": "胡萝卜洗净切丝，西红柿洗净切片；"
        },
        {
            "number": 4,
            "description": "清水煮沸，放入木耳，胡萝卜丝，在放点盐；"
        },
        {
            "number": 5,
            "description": "胡萝卜丝容易熟，提前捞出，提前捞出，过冷水；"
        },
        {
            "number": 6,
            "description": "煮好的木耳捞出，放入便当盒；"
        },
        {
            "number": 7,
            "description": "在把切好的西红柿片摆好，撒上胡萝卜丝；"
        },
        {
            "number": 8,
            "description": "放麻油、生抽、香葱拌均，美美的一顿午餐就好。"
        }
    ],
