    "steps": [
        {
            "number": 1,
            "description": "1烧一锅开水，放入意大利面，煮10分钟。撩起冷水冲一下备用。"
        },
        {
            "number": 2,
            "description": "黄油入锅中火，稍微融化"
        },
        {
            "number": 3,
            "description": "加入番茄炒2分钟使其变软"
        },
        {
            "number": 4,
            "description": "加洋葱炒2分钟成泥"
        },
        {
            "number": 5,
            "description": "放入胡萝卜、香菇炒1分钟胡萝卜变色后"
        },
        {
            "number": 6,
            "description": "加入青红黄椒和番茄酱拌匀"
        },
        {
            "number": 7,
            "description": "加入大虾搅拌约1-2分钟，看到虾变色加入培根丝"
        },
        {
            "number": 8,
            "description": "加入奶酪拌匀"
        },
        {
            "number": 9,
            "description": "加入准备好的面条拌匀"
        },
        {
            "number": 10,
            "description": "最后出锅装盘即可。"
        }
    ],
