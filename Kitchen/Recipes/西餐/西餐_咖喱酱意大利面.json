    "steps": [
        {
            "number": 1,
            "description": "材料准备：煮锅烧开水，意大利面加少许盐和油烧熟备用（喜欢吃的可以多烧点冷藏着）；"
        },
        {
            "number": 2,
            "description": "洋葱切碎，胡萝卜切片，番茄芦笋洗净；以上是我隔天晚上准备好了。"
        },
        {
            "number": 3,
            "description": "热锅下橄榄油 ，炒香洋葱碎；放入胡萝卜炒熟出锅；"
        },
        {
            "number": 4,
            "description": "另取一锅热一下鹌鹑蛋"
        },
        {
            "number": 5,
            "description": "然后芦笋焯水沥干；"
        },
        {
            "number": 6,
            "description": "盛出洋葱和胡萝卜后，再把芦笋放进去略煸出锅；"
        },
        {
            "number": 7,
            "description": "锅中加适量清水放半块咖喱；"
        },
        {
            "number": 8,
            "description": "烧成酱汁备用；"
        },
        {
            "number": 9,
            "description": "把所有材料放在拌一下即可（酱我这里没放进去，后面再放的）。"
        }
    ],
    "_source": "cookbook-kg"
}