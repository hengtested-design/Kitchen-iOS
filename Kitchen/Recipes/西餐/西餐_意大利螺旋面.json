    "steps": [
        {
            "number": 1,
            "description": "番茄、洋葱切丁备用"
        },
        {
            "number": 2,
            "description": "猪肉+料酒腌10分钟"
        },
        {
            "number": 3,
            "description": "炒锅加油爆香蒜末，入猪肉炒至变白后起锅"
        },
        {
            "number": 4,
            "description": "另起锅，入洋葱炒至略透明、下番茄炒至软"
        },
        {
            "number": 5,
            "description": "加入适量番茄酱及水，烧开后转小火，加入适量盐和糖，小火慢煮"
        },
        {
            "number": 6,
            "description": "待煮至软即可起锅，起锅前将炒过的猪肉加入略煮"
        },
        {
            "number": 7,
            "description": "水中加少许盐和色拉油，烧开后下螺旋面煮至熟，捞起，淋上煮好的酱汁，撒上黑胡椒即可"
        }
