    "steps": [
        {
            "number": 1,
            "description": "奶油白酱做法：黄油放锅里用小火加热至溶化。"
        },
        {
            "number": 2,
            "description": "倒入高筋粉搅拌均匀。"
        },
        {
            "number": 3,
            "description": "再慢慢加入清水，每次加一点，然后拌匀了再加下一次。"
        },
        {
            "number": 4,
            "description": "搅拌至无颗粒的顺滑状。"
        },
        {
            "number": 5,
            "description": "倒入牛奶。"
        },
        {
            "number": 6,
            "description": "加盐，小火煮沸，边煮边搅，以免糊底。"
        },
        {
            "number": 7,
            "description": "最后煮成粘稠的酱状即可。"
        },
        {
            "number": 8,
            "description": "意大利面做法：意大利面煮熟，捞出沥干水分。"
        },
        {
            "number": 9,
            "description": "加少许橄榄油拌匀，防止粘连。"
        },
        {
            "number": 10,
            "description": "蛋黄加一大勺奶酪粉，拌匀备用。"
        },
        {
            "number": 11,
            "description": "口蘑洗净，培根切小片；口蘑也切片备用。"
        },
        {
            "number": 12,
            "description": "炒锅烧热，倒入适量橄榄油。"
        },
        {
            "number": 13,
            "description": "放入蒜末爆香。"
        },
        {
            "number": 14,
            "description": "加培根略煎一下，至香味散出。"
        },
        {
            "number": 15,
            "description": "再放入口蘑炒软。"
        },
        {
            "number": 16,
            "description": "加奶油白酱和鲜奶油。"
        },
        {
            "number": 17,
            "description": "把锅中所有食材炒匀。"
        },
        {
            "number": 18,
            "description": "倒入意大利面拌匀。"
        },
        {
            "number": 19,
            "description": "放入盐和黑胡椒粉调味，拌匀。"
        },
        {
            "number": 20,
            "description": "拌匀后熄火，将蛋黄奶酪酱立即倒入，迅速将蛋黄奶酪酱与面条拌匀，盛盘，撒上香菜末即完成。"
        }
    ],
