    "steps": [
        {
            "number": 1,
            "description": "如图所示准备好所有食材。"
        },
        {
            "number": 2,
            "description": "上海青切丝，杏鲍菇切片切条，火腿切片，瘦肉切丁。"
        },
        {
            "number": 3,
            "description": "300g约两个人量的意大利面煮熟（先将水烧开）。"
        },
        {
            "number": 4,
            "description": "煮熟大约需5-7分钟，煮熟后盛盘待用。"
        },
        {
            "number": 5,
            "description": "倒油，煎一个鸡蛋，煎好起锅。"
        },
        {
            "number": 6,
            "description": "倒油，瘦肉炒熟（可加入适量的料酒去腥）。"
        },
        {
            "number": 7,
            "description": "倒入煮熟的意大利面，放入火腿、杏鲍菇。加入适量的盐、生抽。翻炒一分半左右。"
        },
        {
            "number": 8,
            "description": "加入上海青，添加适量的鸡精，稍炒半分钟即可。"
        },
        {
            "number": 9,
            "description": "起锅盛盘享用啦。"
        }
