    "steps": [
        {
            "number": 1,
            "description": "准备好主料。"
        },
        {
            "number": 2,
            "description": "把洋葱洗净切成碎丁。"
        },
        {
            "number": 3,
            "description": "番茄洗净去皮切成丁。"
        },
        {
            "number": 4,
            "description": "锅中注入适量的橄榄油。"
        },
        {
            "number": 5,
            "description": "下入洋葱碎炒香。"
        },
        {
            "number": 6,
            "description": "下入肉末煸炒变色。"
        },
        {
            "number": 7,
            "description": "倒入番茄丁继续煸炒。"
        },
        {
            "number": 8,
            "description": "烹入白葡萄酒。"
        },
        {
            "number": 9,
            "description": "加入2大勺番茄酱煸炒均匀。"
        },
        {
            "number": 10,
            "description": "加入盐和适量的糖煸炒至汤汁粘稠。"
        },
        {
            "number": 11,
            "description": "加入适量的罗勒翻炒均匀即可。"
        },
        {
            "number": 12,
            "description": "番茄肉末酱就做好了。"
        },
        {
            "number": 13,
            "description": "汤锅注入清水烧开，加入盐和1小勺油。"
        },
        {
            "number": 14,
            "description": "下入意面，煮至没有硬芯。"
        },
        {
            "number": 15,
            "description": "把煮好的意面，盛放在盘中。"
        },
        {
            "number": 16,
            "description": "浇上番茄肉末酱即可。"
        }
