    "steps": [
        {
            "number": 1,
            "description": "牛肉馅放入碗中，放入白朗姆酒。"
        },
        {
            "number": 2,
            "description": "放入盐。"
        },
        {
            "number": 3,
            "description": "放入黑胡椒粉，抓拌均匀。"
        },
        {
            "number": 4,
            "description": "放入橄榄油少许，拌匀后静置10分钟。"
        },
        {
            "number": 5,
            "description": "煮锅中添入适量水，水开后滴入几滴橄榄油，放少许盐，放入意面煮至熟。"
        },
        {
            "number": 6,
            "description": "将煮好的意面用冷水冲凉，放入少许橄榄油，拌匀。"
        },
        {
            "number": 7,
            "description": "洋葱洗净，切丁。"
        },
        {
            "number": 8,
            "description": "炒锅烧热，放入橄榄油，油热后放入洋葱、罗勒叶，炒香。"
        },
        {
            "number": 9,
            "description": "放入肉馅，炒散。"
        },
        {
            "number": 10,
            "description": "炒至肉色变浅后放入浓缩橙汁。"
        },
        {
            "number": 11,
            "description": "放入白糖、白醋。"
        }
    ],
