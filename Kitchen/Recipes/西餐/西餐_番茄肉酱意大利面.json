        {
            "number": 1,
            "description": "准备好材料。"
        },
        {
            "number": 2,
            "description": "锅中入热水，加入少量的食盐，放入面条小火煮7分钟。"
        },
        {
            "number": 3,
            "description": "煮好后捞出，凉水过下加入少许的橄榄油拌匀。"
        },
        {
            "number": 4,
            "description": "洋葱、大蒜切碎，番茄对半切开。"
        },
        {
            "number": 5,
            "description": "锅中入油，洋葱和蒜入锅中煸香。"
        },
        {
            "number": 6,
            "description": "加入肉末，炒然后入番茄炒入味。"
        },
        {
            "number": 7,
            "description": "加入番茄酱，加入适量的水、盐、糖炒匀。"
        },
        {
            "number": 8,
            "description": "入面条加入芝士粉。拌匀出锅。"
        }
