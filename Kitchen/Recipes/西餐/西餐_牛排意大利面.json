    "steps": [
        {
            "number": 1,
            "description": "食材准备 番茄 番茄酱  洋葱  牛肉末。"
        },
        {
            "number": 2,
            "description": "番茄切丁备用，用一整个番茄。"
        },
        {
            "number": 3,
            "description": "洋葱用半个，切末备用，眼睛觉得够呛。"
        },
        {
            "number": 4,
            "description": "都切完 摆在这个懒人盘子里。"
        },
        {
            "number": 5,
            "description": "锅内加橄榄油，8成热加入洋葱末翻炒。"
        },
        {
            "number": 6,
            "description": "洋葱炒熟后加入牛肉末继续翻炒。"
        },
        {
            "number": 7,
            "description": "牛肉末变色炒熟。"
        },
        {
            "number": 8,
            "description": "牛肉末熟后加入番茄丁。"
        },
        {
            "number": 9,
            "description": "此事另一锅煮水 开水下意大利面。"
        },
        {
            "number": 10,
            "description": "同时 炒末的锅内加入番茄酱。"
        },
        {
            "number": 11,
            "description": "慢熬至都烂糊了。"
        },
        {
            "number": 12,
            "description": "平底锅煎牛排 这牛排有点难看，小火 ，保留其中的汁水 不用煎太老了，两面侧面都煎一下。"
        },
        {
            "number": 13,
            "description": "面也煮好了 过夏凉水  沥干放盘子内，浇上熬制的意大利面酱，加上一块牛排，一份比宜家意大利面还好吃的 意大利面 +牛排就做好了  ，记得用刀叉吃哦。"
        }
    ],
    "_source": "cookbook-kg"
}