    "steps": [
        {
            "number": 1,
            "description": "准备好材料。"
        },
        {
            "number": 2,
            "description": "香叶和八角洗好，切好葱，姜，蒜。"
        },
        {
            "number": 3,
            "description": "排骨用清水浸泡10分钟左右，中途换1-2次水更好，以去除血水。"
        },
        {
            "number": 4,
            "description": "碗内加入3匙香醋（32g）、1匙料酒(15g)、少许老抽(9g)调和成料汁。"
        },
        {
            "number": 5,
            "description": "冰糖（或白糖）28g，准备好。"
        },
        {
            "number": 6,
            "description": "锅中加适量油，下入沥干水的排骨，中小火煎炒。"
        },
        {
            "number": 7,
            "description": "煎炒至表面变黄。"
        },
        {
            "number": 8,
            "description": "加入生姜片、葱白、八角、桂皮、冰糖，略炒。"
        },
        {
            "number": 9,
            "description": "再加入适量开水，水量没过排骨。"
        },
        {
            "number": 10,
            "description": "再倒入调好的料汁。"
        },
        {
            "number": 11,
            "description": "盖上锅盖，烧开后转小火，炖煮35-40分钟左右，至排骨肉烂。"
        },
        {
            "number": 12,
            "description": "加入少许盐（2g）。"
        },
        {
            "number": 13,
            "description": "转大火开始收汁，汤汁儿收得差不多就可以撒上葱花，关火出锅了。"
        },
        {
            "number": 14,
            "description": "有异味，肉质不新鲜等不宜选购。"
        },
        {
            "number": 15,
            "description": "调料汁的比例可以自己调节，喜欢吃醋的可以适量多加一点，但老抽不可太多，否则容易上色过深。"
        }
    ],
    "_source": "cookbook-kg"
